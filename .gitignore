# Per-user / per-machine mkosi overrides — see mkosi(1) for the
# mkosi.local.conf convention. Use this for things you want during
# local dev (e.g. RootPassword= for VM console login) that should
# NOT ship to the actual HTPC.
mkosi.local.conf
mkosi.local/

# Fetched at build time by build.sh — pinned to a SHA, not source.
mkosi.extra/usr/share/kodi/addons/script.program.homeassistant/
