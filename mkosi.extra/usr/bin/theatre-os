#!/bin/bash
# theatre-os — single entry point for OS-state operations on a running
# box that go beyond what plain systemd tooling covers: persist
# snapshots/restore and experiment mode.
#
# Adding a verb means adding a `cmd-<verb>.sh` under /usr/lib/theatre-os/
# and an arm in the dispatcher below. Sub-verbs (e.g. `snapshot list`)
# are dispatched inside the verb's command file, not here.
#
# Updating is not a verb here — use updatectl directly:
#     updatectl list host        # available + installed versions
#     updatectl update host      # install newest (--reboot to reboot)
# Roll back by picking an older UKI from the systemd-boot menu. The
# image is self-sufficient around that: each UKI's initrd pins its own
# @os/<v> + @persist/<v> mounts, the initrd's snapshot.sh forks
# @persist for a newly-booted version, and theatre-os-persist-gc.service
# reaps orphan @persist late in boot.

set -eu

LIB=/usr/lib/theatre-os
# shellcheck source=/dev/null
. "$LIB/lib.sh"

usage() {
    cat >&2 <<EOF
Usage: theatre-os <command> [args...]

Commands:
  snapshot [name]     Manually snapshot persist for a checkpoint.
    snapshot list       Show snapshots.
    snapshot delete <id>  Drop one.
    snapshot prune      Drop snapshots > 30 days old, with confirm.
  restore <id> [--reboot|--no-reboot]
                      Stage a persist snapshot to be active after the
                      next boot. Reboot to apply (defaults to Yes;
                      --reboot or --no-reboot skips the prompt).
  experiment [--yes|--no]
                      Enter experiment mode (live, no reboot). Reboot to
                      leave. Throwaway scratch for /usr / /etc edits.
                      Defaults to prompting; --yes / --no skip the prompt.

To update the OS, use updatectl directly:
  updatectl list host        # available + installed versions
  updatectl update host      # install newest (--reboot to reboot)
Roll back by selecting an older entry in the systemd-boot menu.

See README → Updates, snapshots & experiment mode.
EOF
    exit 2
}

case "${1:-}" in
    snapshot)
        shift
        # shellcheck source=/dev/null
        . "$LIB/cmd-snapshot.sh"
        cmd_snapshot "$@"
        ;;
    restore)
        shift
        # shellcheck source=/dev/null
        . "$LIB/cmd-snapshot.sh"   # for resolve_snapshot
        # shellcheck source=/dev/null
        . "$LIB/cmd-restore.sh"
        cmd_restore "$@"
        ;;
    experiment)
        shift
        # shellcheck source=/dev/null
        . "$LIB/cmd-experiment.sh"
        cmd_experiment "$@"
        ;;
    -h|--help|help|"")
        usage
        ;;
    *)
        printf 'theatre-os: unknown command: %s\n' "$1" >&2
        usage
        ;;
esac
