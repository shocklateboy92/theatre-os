#!/bin/sh
# theatre-os: launch moonlight-qt on tty2, return to Kodi on tty1
# when it exits.
#
# Triggered from inside Kodi via a Python addon (lives in
# ha-config/kodi/, NOT this repo — userdata is HA-config scope, not
# OS-image scope; see README → Userdata for the split). The addon
# is just `subprocess.Popen("/usr/bin/theatreos-launch-moonlight")`.
#
# Why VT switching: only one process at a time can hold DRM master
# on /dev/dri/card0. Kodi-gbm and moonlight-qt cannot share the
# screen. The kernel revokes Kodi's DRM master when the active VT
# changes, which lets moonlight take it. When moonlight exits, we
# switch back to tty1; Kodi re-acquires DRM master and resumes.
# See README → Display ownership: VT switching for the full story.
#
# The trap ensures we ALWAYS try to return to Kodi's tty even if
# moonlight crashes or we're killed. Kodi v20+ handles DRM master
# loss/regain gracefully, so this is just a polite hand-back.
#
# Qt EGLFS environment variables may need adjusting per-hardware
# (which DRM card, audio backend, etc.). We set sane defaults; the
# Kodi-side launcher addon may override via env vars before
# subprocess.Popen if needed for site-specific tuning.

set -eu

# Always hand the screen back to Kodi on exit.
trap 'chvt 1 2>/dev/null || true' EXIT INT TERM

# Switch to tty2. Kodi loses DRM master; moonlight can grab it.
chvt 2

# Qt EGLFS direct-to-KMS, ALSA audio (matching Kodi's setup so the
# AVR doesn't see a format change mid-handoff). README → Audio
# explains why we go ALSA-direct rather than PipeWire.
export QT_QPA_PLATFORM=eglfs
export QT_QPA_EGLFS_INTEGRATION=eglfs_kms
export QT_MEDIA_BACKEND=alsa

# Real moonlight invocation. No args; moonlight-qt presents its own
# UI for picking host/stream once launched.
exec moonlight-qt
