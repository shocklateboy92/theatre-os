# theatre-os: long-press KEY_POWER → restart kodi-gbm.
#
# See /usr/lib/theatre-os/kodi-watchdog.py for what it does and why
# it runs as root (intentional, ~30 LoC, exactly one possible action).
#
# Watches all /dev/input/event* devices that advertise KEY_POWER
# capability, including hot-plugged ones (via pyudev). When KEY_POWER
# is held for >=3 seconds, runs `systemctl restart kodi-gbm.service` —
# which works regardless of whether kodi or sway/moonlight is currently
# the DRM master (the moonlight unit's Conflicts= machinery handles
# the moonlight case).
#
# Started at boot. Restart=always so transient crashes self-heal —
# this is an escape-hatch service and "broken silently" is the worst
# failure mode.

[Unit]
Description=Theatre-os Kodi watchdog (long-press power → restart kodi)
# We don't need kodi-gbm to be up first; the watchdog should work even
# if kodi-gbm has crashed and we're trying to bring it back. But we do
# want udev settled so /dev/input/event* enumeration is meaningful.
After=systemd-udevd.service
Wants=systemd-udevd.service

[Service]
Type=exec
ExecStart=/usr/bin/python3 /usr/lib/theatre-os/kodi-watchdog.py
Restart=always
RestartSec=2s

# Logging goes to stderr → journal.
StandardOutput=journal
StandardError=journal

# No hardening (no User=, no CapabilityBoundingSet=, no
# ProtectSystem=). The script needs root to systemctl-restart a system
# unit and to open every /dev/input/event*. Adding sandboxing here
# would either restrict what it can do (defeating the purpose) or be
# theatrical (allowing what it actually needs anyway). Keep it simple.

[Install]
WantedBy=multi-user.target
