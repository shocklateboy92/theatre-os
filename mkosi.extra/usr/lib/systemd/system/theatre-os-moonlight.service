# theatre-os: moonlight game streaming as a system unit.
#
# Why a unit (not a shell script): kodi-gbm holds DRM master via
# the legacy ioctl path and does NOT release it on VT switch (Kodi
# upstream confirms: "GBM kodi can't be launched from an active
# desktop... without kodi supporting relinquishing being the master
# when launching the app and reacquiring it afterwards then
# launching another gui app isn't possible" — Kodi forum tid 373067).
# So the only way to hand DRM master to moonlight is to STOP kodi
# entirely (close()s the DRM fd, kernel revokes master), run
# moonlight, then start kodi again. Conflicts=kodi-gbm.service
# does step 1 automatically; ExecStopPost= does step 3.
#
# Why this unit and not a shell script with `systemctl stop kodi-gbm
# && moonlight && systemctl start kodi-gbm`: moonlight needs its own
# logind session for /dev/dri device delegation by libseat (the kodi
# user's own session is on tty1 and goes away when kodi-gbm stops).
# Running moonlight via this unit with PAMName=login + User=kodi
# gets us a fresh logind session with seat0 device access — same
# trick kodi-gbm uses. A shell-out to `runuser` would have to
# re-implement the PAM dance.
#
# Conflicts= is one-directional: starting moonlight stops kodi
# automatically, but stopping moonlight does NOT start kodi. We need
# the explicit ExecStopPost= to bring kodi back, with --no-block to
# avoid a deadlock (kodi can't go active until moonlight is fully
# inactive, moonlight can't go inactive until ExecStopPost returns).
# The `+` prefix runs ExecStopPost as root since starting a system
# unit requires privileges User=kodi doesn't have.
#
# Triggering: the kodi user can `systemctl start
# theatre-os-moonlight.service` without auth via the polkit rule at
# /etc/polkit-1/rules.d/10-theatre-os-moonlight.rules. The Kodi
# launcher addon (in ha-config/kodi/, NOT this repo) does exactly
# that — see README → Kodi & moonlight session.

[Unit]
Description=Moonlight game streaming (theatre-os)
Conflicts=kodi-gbm.service
After=kodi-gbm.service

[Service]
# Mirror kodi-gbm.service's session setup so moonlight gets seat-
# delegated DRM access and a populated XDG_RUNTIME_DIR.
User=kodi
Group=kodi
SupplementaryGroups=audio video optical input video_dma render
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal

# moonlight runs as a wayland client under sway, NOT via Qt EGLFS.
# Why: EGLFS makes Qt own the display directly via KMS, which means
# every video frame goes through Qt's GL compositor — an extra GPU
# pass that added ~one frame (12-17ms) of latency to the moonlight
# stats overlay's "render incl. vsync" reading on this hardware
# (Intel UHD 620). Under sway, moonlight's VAAPI-decoded NV12
# dmabufs go via wlroots's GL render straight to a KMS plane; we
# measured 2-6ms render-incl-vsync on the same hardware after the
# switch, ~one frame saved. Discovered by experiment 2026-05-24.
#
# Sway-specific tunables for further latency reduction live in
# /home/kodi/.config/sway/config (allow_tearing + max_render_time).
# See README → Kodi & moonlight session.
#
# Qt's wayland platform plugin is what makes Qt talk to sway's
# wayland socket (instead of falling back to EGLFS when neither
# wayland nor X11 is detected at startup).
Environment=QT_QPA_PLATFORM=wayland

# Force SDL's audio backend to ALSA. moonlight-qt uses SDL (not Qt
# Multimedia) for the streaming audio path, so QT_MEDIA_BACKEND=alsa
# is a no-op here — SDL's own selection logic is what matters.
#
# Without this, SDL probes PipeWire first. PipeWire is intentionally
# absent from this image (see README → Audio: ALSA-direct for
# lossless TrueHD/DTS-HD passthrough), so the probe fails. SDL falls
# back to ALSA — but the libpipewire client lib leaks a pw_loop on
# every failed probe, and moonlight retries audio open ~once a
# second forever when it can't reach the device. After ~50 retries
# glibc trips a heap consistency check and SIGABRTs the AudioDec
# thread. Setting SDL_AUDIO_DRIVER=alsa skips the PipeWire probe
# entirely. Discovered by experiment 2026-05-13; see
# /etc/asound.conf for the matching device-routing config that lets
# SDL's "default" PCM open actually reach the HDMI/AVR sink.
Environment=SDL_AUDIO_DRIVER=alsa

# Launch moonlight via sway. Sway reads /home/kodi/.config/sway/config
# which fullscreens any window, enables allow_tearing + max_render_time
# on the moonlight surface for minimum latency, and exits when moonlight
# exits (so this unit goes inactive and kodi-gbm comes back via the
# ExecStopPost below).
#
# Arch's moonlight-qt package installs the binary as plain
# /usr/bin/moonlight (no -qt suffix), despite the package name; the
# sway config invokes it by that path.
ExecStart=/usr/bin/sway

# Bring Kodi back when moonlight goes away, regardless of how
# (clean quit from the UI, SIGINT, crash). --no-block prevents the
# Conflicts= deadlock described above. The `+` prefix bypasses
# User=kodi to run as root, which is required to start a system
# unit.
ExecStopPost=+/usr/bin/systemctl --no-block start kodi-gbm.service

# Cosmetic: SIGINT (Ctrl-C while debugging via SSH) and SIGTERM
# (`systemctl stop`) shouldn't show as failed, since they're the
# admin's intent. Normal user-quit-from-UI exits 0 anyway.
SuccessExitStatus=SIGINT SIGTERM

# If sway/moonlight ignore SIGTERM (Qt apps sometimes do when the
# wayland connection is in a weird state), don't leave the screen
# black for the default 90s before SIGKILL kicks in.
TimeoutStopSec=10s

[Install]
# Not enabled at boot; only started on demand by the Kodi launcher
# addon (or `systemctl start` for testing).
