<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="context.go.to.show" version="1.1.0" name="Go to Show" provider-name="lasath">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="kodi.context.item">
        <menu id="kodi.core.main">
            <item library="context.py">
                <label>Go to Show</label>
                <visible>String.IsEqual(ListItem.dbtype,episode) | String.IsEqual(ListItem.dbtype,season)</visible>
            </item>
            <item library="context_season.py">
                <label>Go to Season</label>
                <visible>String.IsEqual(ListItem.dbtype,episode)</visible>
            </item>
        </menu>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Navigate to parent TV show from an episode or season</summary>
        <description lang="en">Adds "Go to Show" and "Go to Season" context menu items for navigating from episodes to their parent show or season.</description>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
    </extension>
</addon>
