<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.watchlist" name="Watchlist" version="1.0.0" provider-name="lasath">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Watchlist ordered by external API</summary>
        <description lang="en">Displays movies from the Kodi library in the order returned by an external watchlist API. Designed for use as a widget source in SkinShortcuts.</description>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
    </extension>
</addon>
