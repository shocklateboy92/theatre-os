<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.theatre.lights.toggle" name="Theatre Lights Toggle" version="1.0.0" provider-name="lasath">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>Toggle kitchen cabinet lights via Home Assistant REST API.</summary>
        <description>Bound to Netflix button (0xF200) in FullscreenVideo. Reads HA URL and token from HAKA addon settings.</description>
        <platform>all</platform>
        <license>MIT</license>
    </extension>
</addon>
