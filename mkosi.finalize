#!/bin/sh
# Create the empty mountpoint stubs for the data + persist mounts
# inside the rootfs being built. We don't ship these via mkosi.extra/
# because git can't track empty dirs without putting marker files in
# them, and those marker files would land in the running rootfs as
# noise. Easier: have finalize create them in $BUILDROOT.
#
# These mountpoints are populated at boot by the corresponding
# sysroot-* mount units shipped in the initrd subimage.
#
# Also synthesize PRETTY_NAME= in /usr/lib/os-release: mkosi has by
# now appended IMAGE_ID= / IMAGE_VERSION= to our
# mkosi.extra/usr/lib/os-release, but nothing sets a versioned
# PRETTY_NAME. IMAGE_VERSION already carries the git SHA (see
# mkosi.version), so provenance lives there — there's no separate
# BUILD_ID= to stamp anymore.

set -eu

mkdir -p "$BUILDROOT/system/data" "$BUILDROOT/system/persist" "$BUILDROOT/efi" "$BUILDROOT/home/kodi"

# Source the os-release mkosi has assembled so far to pull IMAGE_VERSION
# in for the PRETTY_NAME interpolation, then append PRETTY_NAME. Quote
# the value so a -dirty suffix or other unusual chars don't trip the
# shell-grammar parser that consumers (lib.sh, systemd, Kodi, …) use.
#
# shellcheck disable=SC1091  # built file, not present in repo
. "$BUILDROOT/usr/lib/os-release"

ver="${IMAGE_VERSION:-unknown}"

printf 'PRETTY_NAME="Theatre OS %s"\n' "$ver" >> "$BUILDROOT/usr/lib/os-release"
