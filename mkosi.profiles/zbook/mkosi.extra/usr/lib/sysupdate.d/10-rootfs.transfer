# theatre-os rootfs transfer for systemd-sysupdate. (zbook profile)
#
# Pulls theatre-os_<v>.tar from the homelab dufs instance and extracts it
# into a fresh RO btrfs subvolume at /system/data/@os/<v>.
#
# Paired with 20-uki.transfer: same @v, sysupdate treats them as one update
# transaction. See README → Architecture → Distribution and
# README → Build & publish → Pull-side.
#
# The ONLY per-box difference from the t480 profile's copy is the Path=
# segment below (bedroom-tv vs theatre-t480). It MUST match the dufs
# subdir that publish.sh/vacuum.sh push this profile's artefacts to.
# Keep the rest of this file in sync with the t480 copy.
#
# Verify=no disables GPG-signature checking (we don't sign — LAN trust
# boundary); the payload SHA256 is still checked against the manifest.

[Transfer]
Verify=no

[Source]
Type=url-tar
Path=https://static.apps.lasath.com/sysupdate/bedroom-tv/
MatchPattern=theatre-os_@v.tar

[Target]
Type=subvolume
Path=/system/data/@os/
MatchPattern=@v
ReadOnly=yes
InstancesMax=10
