# theatre-os UKI transfer for systemd-sysupdate. (zbook profile)
#
# Pulls theatre-os_<v>.efi and drops it into the ESP at /efi/EFI/Linux/.
# systemd-boot enumerates EFI/Linux/*.efi automatically, so the new entry
# appears in the boot menu on next boot.
#
# Paired with 10-rootfs.transfer: same @v.
#
# The ONLY per-box difference from the t480 profile's copy is the Path=
# segment below (bedroom-tv vs theatre-t480). Keep the rest in sync.
#
# Verify=no for the same reason as 10-rootfs.transfer (no GPG signing;
# SHA256 still enforced). Must be set on this transfer too — Verify=
# applies per-transfer, and this one's url-file source fetches its own
# SHA256SUMS manifest.

[Transfer]
Verify=no

[Source]
Type=url-file
Path=https://static.apps.lasath.com/sysupdate/bedroom-tv/
MatchPattern=theatre-os_@v.efi

[Target]
Type=regular-file
# PathRelativeTo=esp lets sysupdate locate the ESP itself (via the
# standard GPT ESP GUID) rather than requiring /efi to be mounted at
# runtime. Per README → Boot sequence: nothing on the running system
# needs the ESP mounted, so we don't.
Path=/EFI/Linux/
PathRelativeTo=esp
MatchPattern=theatre-os_@v.efi
InstancesMax=10
